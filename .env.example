# Copie para .env e preencha. O arquivo .env NUNCA deve ser enviado ao Git.

# development | production
APP_ENV=development
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# SQLite (dev): deixe vazio. Produção (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://prospeccao:SENHA@db:5432/prospeccao
DATABASE_URL=
DATA_DIR=./data
# Duração da sessão em segundos (8 h)
SESSION_MAX_AGE=28800

# Usuário único. A senha só é usada para criar o usuário na primeira execução;
# depois, altere com: python -m prospeccao.cli set-password
ADMIN_USERNAME=paulo
ADMIN_PASSWORD=

# Dados fictícios (MOCK) — proibidos em produção
ALLOW_MOCK_DATA=true

# Dados abertos do CNPJ (Receita Federal)
RF_BASE_URL=https://arquivos.receitafederal.gov.br/dados/cnpj/dados_abertos_cnpj/
# Filtros da importação (vazio = todas as UFs; CNAEs automáticos a partir dos clientes e segmentos)
RF_FILTER_UFS=
RF_FILTER_CNAE_PREFIXES=
RF_ONLY_ACTIVE=true

# Consulta pontual de CNPJ: brasilapi | opencnpj ; intervalo mínimo entre chamadas (s)
CNPJ_API_PROVIDER=brasilapi
CNPJ_API_MIN_INTERVAL=3

# Enriquecimento pelo site oficial das empresas
WEBSITE_ENRICHMENT_ENABLED=true
WEBSITE_MIN_INTERVAL=5
HTTP_USER_AGENT=ProspeccaoBot/1.0 (+uso privado)

# ICMS — consulta oficial SEFAZ (NfeConsultaCadastro). Requer e-CNPJ A1 em PEM.
# ICMS_CERT_FILE=/run/secrets/ecnpj_cert.pem
# ICMS_KEY_FILE=/run/secrets/ecnpj_key.pem
# JSON UF -> endpoint (confirme os endereços vigentes no portal da SEFAZ de cada UF):
# ICMS_ENDPOINTS={"MS": "https://nfe.sefaz.ms.gov.br/ws/CadConsultaCadastro4"}
ICMS_CERT_FILE=
ICMS_KEY_FILE=
ICMS_ENDPOINTS={}

# Somente para docker-compose
POSTGRES_PASSWORD=
DOMAIN=prospeccao.exemplo.com.br
