# Quebras de linha corretas independentemente do sistema de quem faz o commit
* text=auto
*.py   text eol=lf
*.sh   text eol=lf
Dockerfile text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
deploy/Caddyfile text eol=lf
# Scripts do Windows com CRLF (o cmd.exe exige CRLF em .bat)
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
